# Copy to .env (git-ignored) and fill in.
# Groq API key for the LLM steps of hybrid/
GROQ_API_KEY=your-groq-api-key
# TypeSafe API key for jev/ (the Jev model)
JEV_API_KEY=your-typesafe-api-key
# YAGO 4.5 entity dump: https://yago-knowledge.org/data/yago4.5/yago-entities.jsonl.zip (unzip it).
# hybrid/ needs it; jev/ works without it and uses it as one more check when it is set
YAGO_JSONL=/path/to/yago-entities.jsonl
# Optional, for hybrid/ and jev/: an e-mail or URL sent to Wikipedia (and Wikidata) in the User-Agent. Wikimedia asks API
# clients to say who they are; with a contact the rate limit rises from 10 to about 200 requests a minute.
# WIKIPEDIA_CONTACT=you@example.org
